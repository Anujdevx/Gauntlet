# Adaptive Technical Assessment Simulator -- environment template.
#
# Copy to `.env` and edit. `.env` is gitignored; never commit a real secret.
#
# Two categories, and the split is a security boundary:
#
#   OPERATIONAL   Affects throughput, cost, and where services point. Safe to
#                 tune freely.
#   NO SECRETS    The sandbox images contain no credentials and must never gain
#                 any. A key placed in a sandbox is a key the candidate owns.
#                 Nothing below is read by a sandboxed container.

# ---------------------------------------------------------------- deployment
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------------ services
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------- datastores
# Local-development defaults only. `oa` / `oa_dev_password` are intentionally
# trivial and are refused by any ENVIRONMENT other than `local`.
POSTGRES_USER=oa
POSTGRES_PASSWORD=oa_dev_password
POSTGRES_DB=oa
# Host name `postgres` resolves inside the compose network. Tools you run on the
# host (make migrate, make seed, pytest) need POSTGRES_DSN_HOST instead, which the
# Makefile substitutes automatically.
POSTGRES_DSN=postgresql+asyncpg://oa:oa_dev_password@postgres:5432/oa
POSTGRES_DSN_HOST=postgresql+asyncpg://oa:oa_dev_password@localhost:5432/oa

# Redis serves three roles on separate databases so a broker eviction cannot
# discard a live event stream or a result.
#   db 0: Celery broker (noeviction policy; losing a submission is user-visible)
#   db 1: Celery result backend
#   db 2: payload store and execution event streams
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Swap to RabbitMQ in production without touching code:
#   CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------------ topology
QUEUE_NAME=sandbox.execute
# Worker slots, and therefore forked processes. The warm pool is PER PROCESS, so
# the number of live sandbox containers is:
#
#     WORKER_CONCURRENCY x POOL_SIZE_PER_LANGUAGE x 3 languages
#
# 2 x 2 x 3 = 12 containers, which is comfortable locally. Raising concurrency
# multiplies idle containers; scale out with more machines instead, which is also
# the only approach that actually adds throughput when the daemon is the
# bottleneck.
WORKER_CONCURRENCY=2

# ------------------------------------------------------------------- sandbox
# Container runtime for every execution. This is the ONLY control that differs
# between the two modes -- every other security control (no network, read-only
# rootfs, non-root uid, cap_drop ALL, no-new-privileges, memory and swap bounds,
# pids limit, CPU limit, private IPC, executable tmpfs, read-only grading mount) is
# identical either way, which `test_controls_are_identical_across_runtimes`
# enforces.
#
#   runc   plain Linux container isolation. One layer. Development default,
#          because gVisor cannot run on macOS or Windows.
#   runsc  adds gVisor's userspace kernel as a second isolation layer. REQUIRED in
#          production.
#
# The worker refuses to start if the configured runtime is not registered on the
# daemon, so setting runsc without installing gVisor fails loudly rather than
# silently downgrading to one layer.
#
#   SANDBOX_RUNTIME=runsc   enable the second isolation layer (production)
#   SANDBOX_RUNTIME=runc    development only
SANDBOX_RUNTIME=runc

# Image tags. Pin by digest in production: a mutable tag means the same
# submission could be graded by different grader code a week apart, which
# invalidates historical mastery estimates.
IMAGE_PYTHON=oa/sandbox-python:1.0.0
IMAGE_REACT=oa/sandbox-react:1.0.0
IMAGE_SQL=oa/sandbox-sql:1.0.0

# Idle, pre-started containers per worker PROCESS per language. 0 disables the
# pool and forces cold starts; useful for isolating a suspected pool bug, and the
# right setting on a host with a tight container budget.
POOL_SIZE_PER_LANGUAGE=2
POOL_ACQUIRE_TIMEOUT_S=5.0
POOL_CONTAINER_MAX_IDLE_S=300
POOL_REPLENISH_INTERVAL_S=5

# ------------------------------------------------------------------- frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# Comma-separated allowlist consumed by the API's CORS middleware.
WEB_ORIGIN=http://localhost:3000

# ------------------------------------------------------------ gVisor runtime
# Pinned for provenance: runsc is the syscall interceptor for every submission,
# so a tampered binary would be an invisible total compromise.
RUNSC_VERSION=20241021.0.0
RUNSC_SHA256=

# =====================================================================
# NO SECRETS BELOW THIS LINE
#
# The sandbox orchestrator builds its container environment from a literal dict
# in `apps/worker/src/oa_worker/sandbox/orchestrator.py`. It is asserted by
# `test_environment_carries_no_secrets` in
# `sandbox/tests/test_security_envelope.py`, which fails on any variable name
# containing key/token/secret/password/credential/dsn/://.
#
# Do not add LLM_API_KEY, DATABASE_URL, or similar to this file with the
# intention of exposing them "temporarily" to a challenge. RAG and LLM
# challenges are mocked inside the image for exactly this reason.
# =====================================================================
